# Azure Speech Services Configuration
AZURE_SPEECH_KEY=your_azure_speech_subscription_key
AZURE_SPEECH_REGION=your_azure_region

# Optional: Path to Copilot CLI
COPILOT_CLI_PATH=/usr/local/bin/copilot

# Optional: Keyword model path for custom wakeword
KEYWORD_MODEL_PATH=

# Optional: Azure Speech voice name (default: en-US-JennyNeural)
AZURE_VOICE_NAME=en-US-JennyNeural

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
