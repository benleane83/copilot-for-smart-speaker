{
  "name": "copilot-for-smart-speaker",
  "version": "1.0.0",
  "description": "Desktop application that listens for a wakeword, captures voice input via Azure Speech services, processes conversational requests through GitHub Copilot SDK with agentic capabilities, and responds with synthesized speech.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "copilot",
    "smart-speaker",
    "voice-assistant",
    "azure-speech",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "dotenv": "^16.3.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.34.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
